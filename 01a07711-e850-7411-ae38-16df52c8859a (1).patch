@@ -0,0 +1,48 @@
+{
+  "id": "anaphylaxis",
+  "title": "آنافیلاکسی (واکنش حساسیتی شدید)",
+  "icon": "⚡",
+  "category": "reaction",
+  "version": 4,
+  "updatedAt": "2026-09-07",
+  "summary": "اپی‌نفرین عضلانی فوری در میانهٔ سطح بیرونی ران و تماس با اورژانس",
+  "sources": [
+    "2024 American Heart Association and American Red Cross Guidelines for First Aid — Anaphylaxis",
+    "World Allergy Organization Anaphylaxis Guidance 2020"
+  ],
+  "match": {
+    "hives_widespread": 3,
+    "lip_tongue_swelling": 4,
+    "throat_tightness": 5,
+    "wheezing": 4,
+    "known_allergen_exposure": 2
+  },
+  "riskQuestions": [
+    "lip_tongue_swelling",
+    "throat_tightness",
+    "wheezing",
+    "hives_widespread",
+    "fainting",
+    "known_allergen_exposure",
+    "difficulty_breathing"
+  ],
+  "actions": [
+    "اگر خودکار تزریق اپی‌نفرینِ خود فرد موجود است، فوراً آن را طبق دستور وسیله در میانهٔ سطح قدامی‌ـ‌بیرونی ران تزریق کنید؛ تزریق از روی لباس در صورت مجازبودن وسیله امکان‌پذیر است.",
+    "همان لحظه با اورژانس تماس بگیرید؛ بهترشدن پس از اپی‌نفرین نیاز به ارزیابی اورژانسی را برطرف نمی‌کند.",
+    "فرد را درازکش نگه دارید و اجازهٔ ایستادن یا راه‌رفتن ندهید. اگر تنفس در حالت خوابیده دشوار است می‌تواند بنشیند و پاها را دراز کند؛ باردار را ترجیحاً به پهلوی چپ قرار دهید.",
+    "اگر پس از ۵ تا ۱۵ دقیقه علائم ادامه دارد یا برمی‌گردد و خودکار دوم در دسترس است، طبق راهنمای وسیله/اپراتور دوز دوم را بدهید.",
+    "اگر بی‌هوش ولی دارای تنفس طبیعی است، راه هوایی را باز نگه دارید و در وضعیت بازیابی قرار دهید؛ اگر تنفس طبیعی ندارد CPR و AED را آغاز کنید.",
+    "آنتی‌هیستامین ممکن است علائم پوستی را کم کند، اما تورم راه هوایی یا شوک را درمان نمی‌کند و نباید اپی‌نفرین یا تماس با اورژانس را عقب بیندازد."
+  ],
+  "prohibitions": [
+    "تزریق اپی‌نفرین را به‌خاطر تردید یا انتظار برای آنتی‌هیستامین عقب نیندازید",
+    "اپی‌نفرین را در ساق، باسن، دست یا انگشت تزریق نکنید؛ محل توصیه‌شده میانهٔ سطح بیرونی ران است",
+    "اجازه ندهید فرد ناگهان بایستد یا راه برود",
+    "پس از بهبود ظاهری، فرد را بدون ارزیابی اورژانسی رها نکنید"
+  ],
+  "tip": "آنافیلاکسی می‌تواند بدون کهیر رخ دهد. دشواری تنفس، تورم زبان/گلو، افت هوشیاری یا درگیری هم‌زمان چند دستگاه پس از تماس با حساسیت‌زا را جدی بگیرید.",
+  "emergencyCall": {
+    "always": true,
+    "text": "آنافیلاکسی همیشه اورژانسی است — حتی اگر بعد از اپی‌نفرین بهتر شد (احتمال عود)"
+  }
+}
